# Example configuration - placeholders only. Never commit real values.
# Backend: copy the backend section to backend/.env
# Frontend: copy the frontend section to frontend/.env.local

# ---------------- backend ----------------
APP_ENV=development                 # development | test | production
DATA_BACKEND=sqlite                 # sqlite (local) | dynamodb (AWS)
SQLITE_PATH=                        # default: backend/data/finance.db
AUTH_MODE=local                     # local (email/password + JWT) | cognito (AWS)
JWT_SECRET=                         # required in production with AUTH_MODE=local; auto-generated locally
JWT_TTL_MINUTES=120
COGNITO_REVOCATION_CHECK=true       # cognito mode: reject tokens revoked by sign-out (Cognito GetUser)
TOKEN_CHECK_CACHE_SECONDS=15        # per-token cache for that check
CORS_ORIGINS=http://localhost:5173
ALLOW_DEMO_DATA=true                # false in production
RECEIPT_STORAGE=local               # local | s3
RECEIPT_DIR=                        # default: backend/data/receipts (private, never served statically)
MAX_RECEIPT_BYTES=5242880
TESSERACT_CMD=                      # path to tesseract if not on PATH (Windows default path is auto-detected)
LOG_LEVEL=INFO

# AWS only. In Lambda these are set by infra/template.yaml.
# AWS credentials are never configured here: Lambda uses its IAM role.
AWS_REGION=ap-south-1
DYNAMODB_TABLE=finance-intelligence-prod
RECEIPT_BUCKET=
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=

# ---------------- frontend ----------------
VITE_API_BASE_URL=                  # empty locally (Vite proxies /api); API Gateway URL in AWS
