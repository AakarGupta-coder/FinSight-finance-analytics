# Frontend configuration (copy to .env.local). Only VITE_* values reach the browser,
# so never put secrets here.
# Leave empty for local development (Vite proxies /api to http://127.0.0.1:8000).
# For AWS, set to the API Gateway URL, e.g. https://abc123.execute-api.ap-south-1.amazonaws.com
VITE_API_BASE_URL=
